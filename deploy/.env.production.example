# Production settings for learn.tarctpc.com.
# Copy to <app dir>/shared/.env on the server and fill in every value marked CHANGE.
# Never commit the real file.

APP_NAME="Travel Advisor Resource Center"
APP_ENV=production
# CHANGE: generate locally with `php artisan key:generate --show` and paste the result.
APP_KEY=
APP_DEBUG=false
APP_URL=https://learn.tarctpc.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# CHANGE: the MySQL database and user created in cPanel (MySQL Databases).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_db_name
DB_USERNAME=CHANGE_db_user
DB_PASSWORD=CHANGE_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# CHANGE: an email account created in cPanel, for receipts and notifications later.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_mail.tarctpc.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_noreply@tarctpc.com
MAIL_PASSWORD=CHANGE_mail_password
MAIL_FROM_ADDRESS="noreply@tarctpc.com"
MAIL_FROM_NAME="${APP_NAME}"

# School settings (config/school.php)
SCHOOL_CURRENCY=USD
# Keep "test" until Stripe has been tested end to end with sandbox keys.
PAYMENT_GATEWAY=test
STRIPE_SECRET_KEY=
CHAPA_SECRET_KEY=

TARC_SITE_URL=https://traveladvisorresourcecenter.com
TARC_COMMUNITY_URL=https://traveladvisorresourcecenter.com
TARC_SUPPORT_EMAIL=admin@thetarc.com

VITE_APP_NAME="${APP_NAME}"

# Travel Partner Directory (WordPress) bridge
# Shared secrets between WordPress (TPD Tool) and LMS
TPD_BASE_URL=https://tpd.tarctpc.com
TPD_SSO_SECRET=CHANGE_SHARED_SSO_SECRET
TPD_API_TOKEN=CHANGE_SHARED_API_TOKEN
TPD_WEBHOOK_SECRET=CHANGE_SHARED_WEBHOOK_SECRET
TPD_FRAME_ANCESTORS="'self' https://tpd.tarctpc.com http://localhost:* http://127.0.0.1:*"

